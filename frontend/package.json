{
  "name": "talent-hub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Talent Hub 前端工程（Vite + React + TypeScript）",
  "scripts": {
    "test:unit": "node node_modules/vitest/vitest.mjs run",
    "test:unit:watch": "node node_modules/vitest/vitest.mjs",
    "test:visual": "node node_modules/@playwright/test/cli.js test",
    "test:contract": "node node_modules/vitest/vitest.mjs run tests/contract",
    "build": "node node_modules/vite/bin/vite.js build",
    "dev": "node node_modules/vite/bin/vite.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
